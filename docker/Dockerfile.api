FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /repo
COPY Directory.Build.props .
COPY src/Jarvis.Domain/ src/Jarvis.Domain/
COPY src/Jarvis.Application/ src/Jarvis.Application/
COPY src/Jarvis.Infrastructure/ src/Jarvis.Infrastructure/
COPY src/Jarvis.Agent/ src/Jarvis.Agent/
COPY src/Jarvis.Api/ src/Jarvis.Api/
RUN dotnet publish src/Jarvis.Api/Jarvis.Api.csproj -c Release -o /out --nologo
FROM mcr.microsoft.com/dotnet/aspnet:10.0
USER root
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/* && mkdir -p /data/jarvis /data/obsidian && chown -R 1654:1654 /data
WORKDIR /app
COPY --from=build /out .
USER 1654:1654
EXPOSE 8080
ENTRYPOINT ["dotnet", "Jarvis.Api.dll"]
