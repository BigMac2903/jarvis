# Internal secrets are generated by install.ps1 / install.sh.
# If configuring manually: passwords/tokens = 32 random bytes as hex;
# MASTER_KEY and BROWSER_MASTER_KEY = 32 random bytes as Base64.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MASTER_KEY=
BROWSER_MASTER_KEY=
BROWSER_TOKEN=
SETUP_TOKEN=
SEARXNG_SECRET=
PUBLIC_URL=https://localhost
SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443
OBSIDIAN_HOST_PATH=./data/obsidian
# Optional Docker Compose profiles: search,local-ai,antivirus (comma-separated)
COMPOSE_PROFILES=
# Set to clamav only when the antivirus profile is enabled.
CLAMAV_HOST=
# Exact hostname allowlist for intentional internal research destinations; empty by default.
INTERNAL_ALLOW_HOSTS=
# External API credentials, models and OAuth client secrets are entered in /setup
# or Settings and encrypted with MASTER_KEY in PostgreSQL.
SIP_SERVICE_TOKEN=
# Enable with COMPOSE_PROFILES=sip and docker-compose.sip.yml when receiving PBX traffic.
SIP_BIND_ADDRESS=127.0.0.1
SIP_ADVERTISE_ADDRESS=
