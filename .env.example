# Internal secrets are generated by install.ps1 / install.sh.
# If configuring manually: passwords/tokens = 32 random bytes as hex;
# MASTER_KEY and BROWSER_MASTER_KEY = 32 random bytes as Base64.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MASTER_KEY=
BROWSER_MASTER_KEY=
BROWSER_TOKEN=
SETUP_TOKEN=
SEARXNG_SECRET=
PUBLIC_URL=https://localhost
SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443
OBSIDIAN_HOST_PATH=./data/obsidian
# Optional Docker Compose profiles: search,local-ai,antivirus (comma-separated)
COMPOSE_PROFILES=
# Set to clamav only when the antivirus profile is enabled.
CLAMAV_HOST=
# Research browser always blocks private networks; there is no internal-host exception.
# External API credentials, models and OAuth client secrets are entered in /setup
# or Settings and encrypted with MASTER_KEY in PostgreSQL.
SIP_SERVICE_TOKEN=
# Enable with COMPOSE_PROFILES=sip and docker-compose.sip.yml when receiving PBX traffic.
SIP_BIND_ADDRESS=127.0.0.1
SIP_ADVERTISE_ADDRESS=
# Separate opt-in profile local-network. Dashboard policy must also be enabled.
LOCAL_NETWORK_TOKEN=
LOCAL_NETWORK_ENABLED=false
LOCAL_NETWORK_ALLOWLIST=
LOCAL_NETWORK_PORTS=80,443
LOCAL_NETWORK_PROBES_ENABLED=false
# Additional IP/CIDR denials; control-plane ranges are always denied by the agent.
LOCAL_NETWORK_DENYLIST=
# Optional single private DNS server on UDP/TCP 53; its IP must also match the server allowlist.
LOCAL_NETWORK_DNS=
